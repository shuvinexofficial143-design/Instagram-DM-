{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --import ./server-security-bootstrap.mjs --import tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node --import ./server-security-bootstrap.mjs dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test:ui": "node tests/ui-regressions.mjs",
    "test:connections": "node --import tsx --test tests/connections.test.ts tests/api-esm.test.mjs tests/sheets-recovery.test.ts tests/sheets-toggle.test.tsx",
    "test:dm": "node --test tests/dm-runtime.test.mjs",
    "test:queue": "node --import tsx --test tests/webhook-queue.test.ts",
    "test:security": "node --import tsx --test tests/guest-store-auth.test.mjs",
    "test:support": "node --test tests/support-security.test.mjs",
    "test:customer-data": "node --import tsx --test tests/customer-data.test.ts tests/customer-data-capture.test.mjs",
    "test:automations": "node --test tests/automation-delivery.test.mjs tests/instagram-subscription.test.mjs tests/instagram-accounts.test.mjs tests/customer-sheets.test.mjs tests/inbox-delivery.test.mjs",
    "test:billing": "node --import tsx --test tests/billing.test.ts",
    "test:invoices": "node --import tsx --test tests/invoice.test.ts",
    "test:lifecycle": "node --import tsx --test tests/customer-lifecycle.test.ts",
    "test:dashboard": "node --test tests/dashboard-truth.test.mjs",
    "test:visual": "node --test tests/visual-audit.test.mjs",
    "test:admin": "node --import tsx --test tests/admin-access.test.ts tests/admin-tools.test.ts tests/automation-pause.test.ts tests/campaign-worker.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "undici": "^8.10.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
