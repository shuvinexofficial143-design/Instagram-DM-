{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build && node --import tsx scripts/sync-admin-policy.ts",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/instagram/send-dm",
      "destination": "/api/instagram/account?action=send-dm"
    },
    {
      "source": "/api/usage",
      "destination": "/api/billing?action=usage"
    },
    {
      "source": "/webhook",
      "destination": "/api/webhook"
    },
    {
      "source": "/webhook/",
      "destination": "/api/webhook"
    },
    {
      "source": "/api/google-sheets/connect",
      "destination": "/api/google-sheets?action=connect"
    },
    {
      "source": "/api/google-sheets/callback",
      "destination": "/api/google-sheets?action=callback"
    },
    {
      "source": "/api/google-sheets/status",
      "destination": "/api/google-sheets?action=status"
    },
    {
      "source": "/api/google-sheets/create-sheet",
      "destination": "/api/google-sheets?action=create-sheet"
    },
    {
      "source": "/api/google-sheets/append-lead",
      "destination": "/api/google-sheets?action=append-lead"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {"source":"/customer-data","destination":"/index.html"},
    {
      "source": "/analytics",
      "destination": "/index.html"
    },
    {
      "source": "/automations",
      "destination": "/index.html"
    },
    {
      "source": "/activity",
      "destination": "/index.html"
    },
    {
      "source": "/contacts",
      "destination": "/index.html"
    },
    {
      "source": "/inbox",
      "destination": "/index.html"
    },
    {
      "source": "/integrations",
      "destination": "/index.html"
    },
    {
      "source": "/billing",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/help",
      "destination": "/index.html"
    },
    {
      "source": "/help/faq",
      "destination": "/index.html"
    },
    {
      "source": "/help/billing",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/reset-password",
      "destination": "/index.html"
    },
    {
      "source": "/knowledge",
      "destination": "/index.html"
    },
    {
      "source": "/catalog",
      "destination": "/index.html"
    },
    {
      "source": "/lead-forms",
      "destination": "/index.html"
    },
    {
      "source": "/crm",
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/billing/checkout",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/refunds",
      "destination": "/index.html"
    }
  ],
  "regions": [
    "bom1"
  ],
  "redirects": [
    {
      "source": "/flow-builder",
      "destination": "/automations",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "text/html"
        }
      ],
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
