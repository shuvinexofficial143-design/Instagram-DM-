# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DYNAMIC MULTI-KEY ROTATION & FAILOVER POOL:
# You can add as many GEMINI_API_KEY_1, GEMINI_API_KEY_2, GEMINI_API_KEY_3... keys as needed.
# The server automatically scans process.env for all keys starting with GEMINI_API_KEY_
# and performs round-robin rotation + automatic 429 rate-limit failover across all of them!
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INSTAGRAM / META GRAPH API CONFIGURATION
INSTAGRAM_APP_ID="your_instagram_app_id"
INSTAGRAM_APP_SECRET="your_instagram_app_secret"
WEBHOOK_VERIFY_TOKEN="tezdm_secret_verify_token_2026"
REDIRECT_URI="https://your-app-url.com/api/auth/instagram/callback"

# SECURITY: Stable server-side secret used to sign the short-lived authenticated
# browser session cookie that binds Instagram OAuth callbacks to the Firebase UID.
# Use a long random value in production and never expose it to VITE_* client variables.
AUTH_SESSION_SECRET="replace_with_a_long_random_server_only_secret"

# FIREBASE CONFIGURATION (OPTIONAL)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ADMIN ACCESS CONTROL
# Comma-separated list of authorized administrator emails (default includes devsinghparmar9589@gmail.com)
ADMIN_EMAILS="devsinghparmar9589@gmail.com"

